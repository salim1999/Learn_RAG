{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAG Academy corpus",
  "type": "object",
  "required": [
    "id",
    "title",
    "as_of",
    "documents"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "source",
          "date",
          "version",
          "superseded_by",
          "tags",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "version": {
            "type": "string"
          },
          "superseded_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
