{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAG Academy level (source or public API)",
  "type": "object",
  "required": [
    "id",
    "title",
    "subtitle",
    "theory",
    "tasks"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 14
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "theory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "heading",
          "body_md",
          "key_points"
        ],
        "properties": {
          "visual": {
            "enum": [
              "pipeline",
              "vectorspace",
              "agents",
              "timeline",
              "hallucination",
              null
            ]
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": [
        "id",
        "type",
        "title",
        "prompt",
        "xp",
        "difficulty"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "quiz",
            "better",
            "order",
            "spot",
            "tune",
            "freshness",
            "code",
            "explain",
            "boss"
          ]
        },
        "title": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "xp": {
          "type": "integer",
          "minimum": 0
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "solution": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "quiz"
              }
            }
          },
          "then": {
            "required": [
              "options",
              "multi"
            ],
            "properties": {
              "options": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "text"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    }
                  }
                }
              },
              "multi": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "better"
              }
            }
          },
          "then": {
            "required": [
              "variant_a",
              "variant_b"
            ],
            "properties": {
              "variant_a": {
                "type": "object",
                "required": [
                  "label",
                  "description"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                }
              },
              "variant_b": {
                "type": "object",
                "required": [
                  "label",
                  "description"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "order"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ],
            "properties": {
              "items": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "text"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "spot"
              }
            }
          },
          "then": {
            "required": [
              "context",
              "answer_sentences"
            ],
            "properties": {
              "context": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "text"
                  ]
                }
              },
              "answer_sentences": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "text"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "tune"
              }
            }
          },
          "then": {
            "required": [
              "query",
              "params",
              "target",
              "base_config"
            ],
            "properties": {
              "params": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "min",
                    "max",
                    "step",
                    "default"
                  ]
                }
              },
              "target": {
                "type": "object",
                "required": [
                  "metric",
                  "threshold",
                  "label"
                ],
                "properties": {
                  "metric": {
                    "enum": [
                      "recall_at_k",
                      "precision_at_k",
                      "mrr",
                      "faithfulness",
                      "freshness_score",
                      "context_precision"
                    ]
                  },
                  "threshold": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "freshness"
              }
            }
          },
          "then": {
            "required": [
              "question",
              "documents",
              "options"
            ],
            "properties": {
              "documents": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "title",
                    "date",
                    "text"
                  ]
                }
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "text"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "code"
              }
            }
          },
          "then": {
            "required": [
              "language",
              "template",
              "blanks"
            ],
            "properties": {
              "language": {
                "const": "python"
              },
              "template": {
                "type": "string"
              },
              "blanks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "explain"
              }
            }
          },
          "then": {
            "required": [
              "question"
            ],
            "properties": {
              "question": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "boss"
              }
            }
          },
          "then": {
            "required": [
              "story",
              "lives",
              "steps"
            ],
            "properties": {
              "story": {
                "type": "string"
              },
              "lives": {
                "const": 3
              },
              "steps": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/task"
                    },
                    {
                      "properties": {
                        "type": {
                          "not": {
                            "const": "boss"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
