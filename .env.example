# All learning features work without any keys. Copy to .env only if needed.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional RunPod dense embedding / cross-encoder endpoint (not required).
RUNPOD_API_KEY=
RUNPOD_EMBED_ENDPOINT_ID=
RUNPOD_TIMEOUT=30

# Local HTTP server. Use another port if 8000 is occupied.
RAG_ACADEMY_HOST=127.0.0.1
RAG_ACADEMY_PORT=8000
# RAG_ACADEMY_DB=data/progress.db
# RAG_ACADEMY_AGENT_DELAY=0.35
